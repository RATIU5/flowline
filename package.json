{
  "name": "flowline-root",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deps:check": "bun run scripts/src/check-versions.ts",
    "prepare": "effect-tsgo patch --oxlint",
    "dev:fe": "bun run --elide-lines 0 --filter frontend dev",
    "dev:be": "bun run --elide-lines 0 --filter backend dev",
    "db:up": "set -a && source apps/backend/.env && set +a && podman run -d --name postgres -e POSTGRES_USER=${DB_USER} -e POSTGRES_PASSWORD=${DB_PASSWORD} -e POSTGRES_DB=${DB_NAME} -p 5432:5432 -v pgdata:/var/lib/postgresql/data postgres:16-alpine",
    "db:down": "podman stop postgres && podman rm postgres",
    "db:logs": "podman logs -f postgres",
    "db:migrate": "bun run --elide-lines 0 --filter @flowline/db migrate",
    "db:seed": "bun run --elide-lines 0 --filter @flowline/db seed",
    "db:codegen": "bun run --elide-lines 0 --filter @flowline/db codegen",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt --write",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "typecheck": "bun run --elide-lines 0 --filter '*' typecheck",
    "test": "bun run --workspaces test",
    "clean:all": "bun run clean:dist && bun run clean:packages",
    "clean:dist": "rimraf packages/**/dist",
    "clean:packages": "rimraf node_modules apps/**/node_modules packages/**/node_modules bun.lock && echo 'Re-install required'"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:effect",
    "@effect/tsgo": "catalog:typescript",
    "@oxlint/plugins": "catalog:lint",
    "@types/bun": "latest",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "rimraf": "^6.1.3",
    "typescript": "catalog:typescript",
    "typescript-legacy": "npm:typescript@6.0.3",
    "vitest": "catalog:testing"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "@sveltejs/kit@2.70.2": "patches/@sveltejs%2Fkit@2.70.2.patch",
    "@sveltejs/kit@2.70.3": "patches/@sveltejs%2Fkit@2.70.2.patch"
  },
  "workspaces": {
    "packages": [
      "packages/**/*",
      "apps/**/*",
      "scripts"
    ],
    "catalog": {
      "vite": "8.2.2"
    },
    "catalogs": {
      "lint": {
        "oxfmt": "0.67.0",
        "oxlint": "1.81.0",
        "@oxlint/plugins": "1.82.0",
        "oxlint-tsgolint": "7.0.2001"
      },
      "typescript": {
        "@effect/tsgo": "0.41.0",
        "typescript": "7.0.2"
      },
      "auth": {
        "better-auth": "^1.7.3"
      },
      "db": {
        "kysely": "0.29.5",
        "kysely-codegen": "0.20.0",
        "kysely-ctl": "0.21.0"
      },
      "testing": {
        "vitest": "^5.0.0"
      },
      "tailwindcss": {
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "tailwindcss": "4.3.3"
      },
      "svelte": {
        "@sveltejs/adapter-auto": "7.0.1",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "svelte": "5.57.0",
        "svelte-check": "4.7.6",
        "sveltekit-effect-runtime": "1.3.0"
      },
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-browser": "4.0.0-rc.112",
        "@effect/language-service": "^0.87.2",
        "@effect/sql-pg": "4.0.0-rc.112",
        "@effect/opentelemetry": "4.0.0-rc.112",
        "@effect/vitest": "4.0.0-rc.112"
      }
    }
  }
}
