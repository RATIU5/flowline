{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": ["**/types/db.ts"],
  "svelte": true,
  "sortTailwindcss": {
    "stylesheet": "./apps/frontend/src/routes/layout.css",
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true
  },
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      ["type-parent", "type-sibling", "type-index"],
      "unknown"
    ],
    "newlinesBetween": true,
    "order": "asc"
  }
}
